generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum MappingType {
  REPORTING
  INTERCOMPANY
}

enum SyncJobMode {
  QUICK
  PERIOD
  FULL
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  OTHER
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  passwordHash       String
  role               UserRole           @default(USER)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  addonSlots         Int                @default(0)
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  companies          Company[]
  accurateCredential AccurateOAuthCredential?
  eliminationMappings EliminationMapping[]
  syncJobs            SyncJob[]
}

model AccurateOAuthCredential {
  id                    String   @id @default(cuid())
  userId                String?  @unique
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenType             String   @default("bearer")
  scope                 String?
  expiresAt             DateTime
  accurateUserId        String?
  accurateUserName      String?
  accurateUserEmail     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Company {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  accurateDbId String?
  tenantDbKey  String?  @unique
  accurateHost String?
  sessionId    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  accounts     Account[]
  journals     Journal[]
  sourceMappings EliminationMapping[] @relation("SourceCompany")
  targetMappings EliminationMapping[] @relation("TargetCompany")
  mappings     AccountMapping[]
  syncJobs     SyncJob[]
  journalSyncWatermark DateTime?
  journalFullSyncedAt  DateTime?

  @@index([userId])
}

model Account {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accurateId  String?
  accountNo   String
  name        String
  type        AccountType @default(OTHER)
  reportGroup String?
  parentNo    String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lines       JournalLine[]
  sourceMappings EliminationMapping[] @relation("SourceAccount")
  targetMappings EliminationMapping[] @relation("TargetAccount")

  @@unique([companyId, accountNo])
  @@index([companyId, type])
}

model Journal {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accurateId  String
  number      String?
  transDate   DateTime
  description String?
  lastUpdate  DateTime?
  raw         Json?
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([companyId, accurateId])
  @@index([companyId, transDate])
}

model JournalLine {
  id         String   @id @default(cuid())
  journalId  String
  journal    Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id])
  accountNo  String
  memo       String?
  debit      Decimal  @default(0) @db.Decimal(20, 6)
  credit     Decimal  @default(0) @db.Decimal(20, 6)
  customerNo String?
  vendorNo   String?
  projectNo  String?
  department String?
}

model EliminationMapping {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceCompanyId String
  sourceCompany   Company  @relation("SourceCompany", fields: [sourceCompanyId], references: [id], onDelete: Cascade)
  sourceAccountId String
  sourceAccount   Account  @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  targetCompanyId String
  targetCompany   Company  @relation("TargetCompany", fields: [targetCompanyId], references: [id], onDelete: Cascade)
  targetAccountId String
  targetAccount   Account  @relation("TargetAccount", fields: [targetAccountId], references: [id], onDelete: Cascade)
  note            String?
  eliminationDate DateTime @default(now())
  amount          Decimal  @default(0) @db.Decimal(20, 6)
  sourceDebit     Decimal  @default(0) @db.Decimal(20, 6)
  sourceCredit    Decimal  @default(0) @db.Decimal(20, 6)
  targetDebit     Decimal  @default(0) @db.Decimal(20, 6)
  targetCredit    Decimal  @default(0) @db.Decimal(20, 6)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, sourceAccountId, targetAccountId])
  @@index([userId])
}


model AccountMapping {
  id              String      @id @default(cuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountNo       String
  type            MappingType
  consolidatedKey String
  counterpartyId  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([companyId, accountNo, type])
}


model SyncJob {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mode                 SyncJobMode
  status               SyncJobStatus @default(QUEUED)
  fromDate             DateTime?
  toDate               DateTime?
  currentPage          Int           @default(1)
  pageCount            Int           @default(1)
  rowCount             Int           @default(0)
  processedJournals    Int           @default(0)
  processedLines       Int           @default(0)
  skippedUnchanged     Int           @default(0)
  detailCalls          Int           @default(0)
  failedCount          Int           @default(0)
  errorMessage         String?
  maxSourceLastUpdate  DateTime?
  startedAt            DateTime?
  heartbeatAt          DateTime?
  finishedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId, status])
  @@index([companyId, createdAt])
}

model ManualElimination {
  id          String   @id @default(cuid())
  userId      String?
  transDate   DateTime
  accountKey  String
  description String?
  debit       Decimal  @default(0) @db.Decimal(20, 6)
  credit      Decimal  @default(0) @db.Decimal(20, 6)
  createdAt   DateTime @default(now())

  @@index([userId])
}
